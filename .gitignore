
# Node modules
node_modules/

# Logs
logs
*.log

# Environment
#
# Everything .env-ish is ignored, with .env.example the one exception. Listing the
# exact filenames was not enough: an editor that appends an extension produces
# `.env.local.txt`, which held real credentials and was perfectly committable. The
# broad pattern means a mis-named credentials file cannot be added by accident.
.env*
!.env.example

# Build output
dist/

# VSCode
.vscode/

# MacOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Local models or large assets
models/audio/*.onnx
models/**/*.h5
