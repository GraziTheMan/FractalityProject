# Fractality Platform — frontend environment
#
# Copy to `.env.local` for local development. Vite loads that automatically and
# it is gitignored.
#
#     cp .env.example .env.local
#
# IMPORTANT: only VITE_-prefixed names reach client code, and they are inlined
# into the bundle at BUILD time. That means:
#   * changing one requires a rebuild, not just a restart
#   * anything here is PUBLIC — visible to anyone who opens devtools
#
# Never put a provider API key (Anthropic/OpenAI/Google), a database password,
# or any other secret in this file. Those belong to the server only.


# --- Backend ---------------------------------------------------------------

# Base URL of the Fractality API (mind maps, feed, users).
# Unset means the app runs standalone against local test data.
# VITE_API_BASE=https://api.fractiverse.com

# Realtime endpoint for chat. Unset disables chat entirely.
# VITE_SOCKET_URL=https://api.fractiverse.com

# Server-side AI proxy. This is what makes multi-AI chat possible WITHOUT
# shipping provider keys to the browser: the proxy holds the credentials.
# Unset leaves the AI participant disabled.
# VITE_AI_PROXY_URL=https://api.fractiverse.com/ai


# --- Accounts --------------------------------------------------------------

# Clerk PUBLISHABLE key (pk_test_... or pk_live_...).
#
# This is the one credential that legitimately belongs in a VITE_ variable:
# publishable keys are designed to be public, which is the whole point of the
# publishable/secret split. Clerk's SECRET key (sk_...) must never appear here,
# and in fact is not used anywhere in this project — the API verifies tokens
# against Clerk's public JWKS instead.
#
# Unset leaves accounts disabled; public maps stay browsable.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...


# --- Local developer tooling ----------------------------------------------

# The Python CLI bridge (NodeBridge), served by the fractality_cli tooling on
# your own machine. Defaults to http://localhost:8001 during `npm run dev` and
# is disabled in production builds, since a deployed page cannot reach your
# localhost and mixed http content is blocked on an https site.
# VITE_CLI_BRIDGE_URL=http://localhost:8001


# --- Server-side only (NOT VITE_, never sent to the browser) ---------------
# Set these on the API service, not the static site.
#
# Paste these from the AuraDB credentials file verbatim. Current Aura uses the
# INSTANCE ID as the username (matching the URI subdomain), not "neo4j", and
# spells the variable NEO4J_USERNAME. Both spellings are accepted.
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=xxxxxxxx
# NEO4J_PASSWORD=
#
# Leave NEO4J_DATABASE unset to use the server's default database. Forcing the
# name "neo4j" breaks instances whose default is named otherwise.
# NEO4J_DATABASE=
# CLERK_ISSUER=https://your-app-12.clerk.accounts.dev
# CORS_ORIGIN=https://fractiverse.com
# ENVIRONMENT=production
#
# Local development only: accept "dev:<user_id>" bearer tokens so the API can be
# exercised without Clerk. Refused outright when ENVIRONMENT=production.
# ALLOW_DEV_AUTH=true
#
# For the future AI proxy (step 5):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_AI_KEY=
#
# See docs/DEPLOYMENT.md for which of these goes on which Render service.
